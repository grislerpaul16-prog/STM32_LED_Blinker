# Renode script for STM32F4 Discovery LED Blinker simulation
mach create "stm32f4_discovery"
machine LoadPlatformDescription @platforms/boards/stm32f4_discovery.repl

$bin?=$CWD/build/blink.elf

macro reset
"""
    sysbus LoadELF $bin
"""

runMacro reset

echo "Firmware loaded from: $bin"
echo "Commands: 'start' to run emulation, 'pause' to halt, 'gpioPortD.UserLED State' to check LED."

